#: src/seedsigner/gui/screens/tools_screens.py
msgid "Heads = 1"
msgstr "Caras = 1"

#. How we call the "back" side result during a coin toss.
#: src/seedsigner/gui/screens/tools_screens.py
msgid "Tails = 0"
msgstr "Coroas = 0"

